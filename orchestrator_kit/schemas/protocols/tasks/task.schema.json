{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "company-os/task/2",
  "title": "Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "parent_task_id",
    "objective",
    "assigned_agent",
    "created_by",
    "priority",
    "status",
    "dependencies",
    "acceptance_criteria",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "task_id": {
      "$ref": "#/$defs/uid"
    },
    "parent_task_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/uid"
        },
        {
          "type": "null"
        }
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "assigned_agent": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_by": {
      "type": "string"
    },
    "priority": {
      "enum": [
        "low",
        "normal",
        "high",
        "critical"
      ]
    },
    "status": {
      "enum": [
        "PENDING",
        "PLANNED",
        "RUNNING",
        "BLOCKED",
        "WAITING_APPROVAL",
        "FAILED",
        "COMPLETED",
        "CANCELLED"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/uid"
      }
    },
    "budget": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "max_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "max_wall_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "inputs": {
      "type": "object"
    },
    "required_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Artifact types that must exist for completion."
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "approval_level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "artifact_id references"
      }
    },
    "result": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "summary": {
          "type": "string"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "owner": {
      "type": "string",
      "description": "Agent accountable for the outcome (usually the run owner or a department head)."
    },
    "skill": {
      "type": [
        "string",
        "null"
      ],
      "description": "Skill ref id[@version] the task is executed with."
    },
    "model_policy": {
      "type": [
        "string",
        "null"
      ]
    },
    "attempts": {
      "type": "integer",
      "minimum": 0
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1
    },
    "cost_usd": {
      "type": "number",
      "minimum": 0,
      "description": "Actual cost so far (sum of harness calls)."
    },
    "blocked_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "verification": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "PASS",
            "FAIL",
            "NEEDS_REVIEW"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verifier": {
          "type": "string"
        }
      }
    },
    "decision_options": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "If set, the result must select one of these."
    },
    "approval_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "ai": {
      "anyOf": [
        {
          "$ref": "../ai/1"
        },
        {
          "type": "null"
        }
      ],
      "description": "Per-task AI override (highest precedence)."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "COMPLETED"
          }
        }
      },
      "then": {
        "required": [
          "evidence"
        ],
        "properties": {
          "evidence": {
            "minItems": 1
          }
        },
        "description": "Evidence over claims: COMPLETED requires at least one artifact reference."
      }
    }
  ],
  "$defs": {
    "uid": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"
    }
  }
}
