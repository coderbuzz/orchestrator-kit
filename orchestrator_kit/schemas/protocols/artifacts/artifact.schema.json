{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "company-os/artifact/1",
  "title": "Artifact (evidence record)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "type",
    "location",
    "created_by",
    "created_at",
    "version",
    "status",
    "evidence"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "An artifact type defined in protocols/artifacts/evidence-requirements.yaml (validate checks agent and skill outputs against it; unknown types are stored as `other`)."
    },
    "location": {
      "type": "string",
      "description": "URL, repo path, or storage URI. The artifact body is not embedded."
    },
    "created_by": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "submitted",
        "accepted",
        "rejected",
        "superseded"
      ]
    },
    "evidence": {
      "type": "object",
      "description": "Verifiable proof: e.g. {sha, check_url, metric}. May be empty only for drafts."
    },
    "task_id": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "accepted",
              "submitted"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "minProperties": 1
          }
        }
      }
    }
  ]
}
