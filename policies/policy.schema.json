{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "company-os/policy/1",
  "title": "Policy (file suffix: .policy.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "domain", "description", "rules"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "domain": {"enum": ["authority", "security", "finance", "production", "communication", "governance"], "description": "Must equal the policies/<domain>/ directory."},
    "description": {"type": "string"},
    "rules": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "statement", "enforcement"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "statement": {"type": "string"},
        "enforcement": {"enum": ["deterministic", "advisory"], "description": "deterministic = checked by code/state machine; advisory = guidance for agents."}
      }}},
    "parameters": {"type": "object", "description": "Tunable values (thresholds, levels). null = not set; set per environment in config/."}
  }
}
