{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "company-os/capability/1",
  "title": "Capability catalog (file suffix: .capabilities.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "capabilities"],
  "properties": {
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "capabilities": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "description", "risk"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "description": {"type": "string"},
        "risk": {"enum": ["read", "write", "external", "irreversible"]},
        "min_approval_level": {"type": "integer", "minimum": 0, "maximum": 4},
        "adapter": {"type": ["string", "null"], "description": "Path under tools/adapters implementing it; null = not implemented yet."}
      }}}
  }
}
